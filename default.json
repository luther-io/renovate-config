{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for vidluther's repositories",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "security:minimumReleaseAgeNpm",
    ":configMigration"
  ],
  "timezone": "Asia/Kolkata",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "automergeSchedule": ["after 10am and before 5pm every weekday"],
  "platformAutomerge": false,
  "platformCommit": "enabled",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Stay on TypeScript < 7 (the Go-based compiler breaks too much tooling)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Automerge patch updates once CI passes",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Low-risk: group and automerge devDependency minor/patch updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies (non-major)",
      "automerge": true
    },
    {
      "description": "Low-risk: group and automerge GitHub Actions minor/patch updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions (non-major)",
      "automerge": true
    },
    {
      "description": "Major updates wait for approval in the dependency dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
